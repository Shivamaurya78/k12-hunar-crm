# Supabase PostgreSQL connection
DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres
DB_USERNAME=YOUR_SUPABASE_DATABASE_USERNAME
DB_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD

# JWT signing secret - use a strong random secret in deployment
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Initial admin account - used by AdminSeeder on first startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# Local server port
PORT=8080

# Frontend API base URL - configure in the frontend deployment
VITE_API_URL=http://localhost:8080/api

FRONTEND_URL=http://localhost:5173